---
import { StoryblokPreview } from "@storyblok/astro";
import { apiClient, StoryblokBlock } from "../storyblok";
import BaseLayout from "../layouts/BaseLayout.astro";

const { slug } = Astro.params;

const { data } = await apiClient.stories.get(slug || "home", {
	query: {
		version: "draft",
		resolve_relations: "featured_articles.articles",
	},
});
const story = data?.story;

if (!story) {
	return new Response(null, { status: 404 });
}
---

<BaseLayout>
	<StoryblokBlock block={story.content} />
	<StoryblokPreview />
</BaseLayout>
