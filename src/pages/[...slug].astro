---
import { getPayload } from '@storyblok/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { apiClient, StoryblokBlock } from '../storyblok';

const { slug } = Astro.params;

const payload = await getPayload({ locals: Astro.locals });

const story =
	payload.story ??
	(
		await apiClient.stories.get(slug ?? 'home', {
			query: {
				resolve_relations: 'featured_articles.articles',
				version: 'draft',
			},
		})
	).data?.story;

if (!story) {
	return new Response(null, { status: 404 });
}
---

<BaseLayout>
	<StoryblokBlock block={story.content} />
</BaseLayout>
