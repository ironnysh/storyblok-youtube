---
import { StoryblokPreview } from '@storyblok/astro';
import Header from '../components/Header.astro';
import '/src/styles/global.css';
---

<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width">
		<title>Embed a YouTube video in Storyblok with Astro</title>
		<meta name="generator" content={`${Astro.generator} + Storyblok`}>
	</head>
	<body>
		<Header />
		<slot />
		<StoryblokPreview
			liveUpdate
			bridgeOptions={{
				customParent: 'https://app.storyblok.com',
				resolveRelations: ['featured_articles.articles'],
			}}
		/>
	</body>
</html>
