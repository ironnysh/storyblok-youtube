---
import { apiClient, StoryblokBlock } from "../storyblok";

const { data } = await apiClient.stories.get("config", {
  query: { version: "draft",
	resolve_links: "url" },
});

const story = data?.story;

if (!story) {
  return new Response(null, { status: 404 });
}

const headerMenu = data?.story?.content?.header_nav ?? [];

const getHref = (link) => {
	const url = link?.story?.url ?? "";
	return url === "/" ? "/" : `/${url}`;
};
---

<header>
	<a href="/">
		<h1>Storyblok + Astro</h1>
	</a>
	<nav>
		{
			headerMenu.map((nav_item) => (
				<a href={getHref(nav_item?.link)}>
					{nav_item?.link?.story?.name ?? "Menu item"}
				</a>
			))
		}
	</nav>
</header>
<style>
	header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	nav {
		display: flex;
		gap: 1rem;
	}
</style>
