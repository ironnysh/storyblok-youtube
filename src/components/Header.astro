---
import { apiClient } from '../storyblok';

const { data } = await apiClient.stories.get('config', {
	query: {
		resolve_links: 'url',
		version: 'draft',
	},
});
const config = data?.story?.content;
const headerNav =
	config?.component === 'config' ? (config.header_nav ?? []) : [];
const headerMenu = headerNav.map((menu) => {
	const linkedStory = data?.links?.find((link) => link.uuid === menu.link?.id);
	return { name: linkedStory?.name, url: `/${menu.link?.cached_url}` };
});
---

<header>
	<a href="/">
		<h1>Storyblok + Astro</h1>
	</a>
	<nav>
		{headerMenu.map((menu) => <a href={menu.url}>{menu.name}</a>)}
	</nav>
</header>
<style>
header {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	gap: 1rem;
}
nav {
	display: flex;
	gap: 1rem;
}
</style>
