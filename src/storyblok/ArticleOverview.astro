---
import { apiClient } from "../storyblok";
const { block, editable } = Astro.props;

const { data } = await apiClient.stories.list({
	query: {
		version: "draft",
		starts_with: "articles",
		content_type: "article",
	},
});

const articles = data?.stories ?? [];
---

<ul {...editable}>
	<h2>{block.title}</h2>
	{
		articles.map((article) => (
			<li>
				<a href={`/${article.full_slug}`}>{article.content.title}</a>
			</li>
		))
	}
</ul>
