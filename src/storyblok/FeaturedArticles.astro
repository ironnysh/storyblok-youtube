---
import type { Story } from "@storyblok/api-client";
const { block, editable } = Astro.props;
---

<section {...editable}>
	<h2>Featured articles</h2>
	<ul>
		{
			block.articles?.map((article: Story) => (
				<li>
					<p>
						<a href={`/${article.full_slug}`}>
							{article.content.title}
						</a>
					</p>
					<p>{article.content.lead}</p>
				</li>
			))
		}
	</ul>
</section>
