---
import type { StoryblokBlockComponentProps } from '@storyblok/astro';
import type { Block } from '../schema/schema';

type Props = StoryblokBlockComponentProps<Block<'article'>>;

import { StoryblokRichText } from '../storyblok';

const { block, editable } = Astro.props;
---

<article {...editable}>
	<h2>{block.title}</h2>
	<p>{block.lead}</p>
	<StoryblokRichText document={block.content} />
</article>
